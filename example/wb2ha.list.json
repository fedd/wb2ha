{

    "only": [
        "wb-w1"
    ],

    "modify": {
        "fl2_hallway_thermostat/setPoint": "thermostat",
        "fl1_hall_thermostat/setPoint": "thermostat",
        "fl1_living_thermostat/setPoint": "thermostat",
        "fl1_toilet_thermostat/setPoint": "thermostat",
        "fl2_south_toilet_thermostat/setPoint": "thermostat",
        "fl2_east_toilet_thermostat/setPoint": "thermostat",

        "fl1_kitchen_shutter_left/targetPosition": "rollshutter",
        "fl1_kitchen_shutter_right/targetPosition": "rollshutter",
        "fl1_dining_shutter/targetPosition": "rollshutter",
        "fl1_living_shutter/targetPosition": "rollshutter",
        "fl1_office_shutter/targetPosition": "rollshutter",
        "fl1_storage_shutter/targetPosition": "rollshutter",
        "fl1_boiler_shutter/targetPosition": "rollshutter"
    },

    "namedModifiers": {
        "wbLedLight": {
            "type": "light",
            "mod": {
                "brightness_state_topic": "/devices/{device.id}/controls/{control.id} Brightness",
                "brightness_command_topic": "/devices/{device.id}/controls/{control.id} Brightness/on",
                "brightness_scale": 100
            }
        },
        "thermostat": {
            "type": "climate",
            "mod": {
                "current_temperature_topic": "/devices/{device.id}/controls/temperature",
                "max_temp": "{control.meta.max}",
                "min_temp": "{control.meta.min}",
                "temperature_command_topic": "/devices/{device.id}/controls/{control.id}/on",
                "temperature_state_topic": "/devices/{device.id}/controls/{control.id}",
                "temperature_unit": "C",

                "preset_modes": [
                    "off",
                    "low",
                    "on",
                    "hi"
                ],
                "preset_mode_state_topic": "/devices/{device.id}/controls/mode",
                "preset_mode_command_topic": "/devices/{device.id}/controls/mode/on",

                "modes": [
                    "heat",
                    "off"
                ],
                "mode_state_topic": "/devices/{device.id}/controls/mode",
                "mode_state_template": "{{ 'off' if value == 'off' else 'heat' }}",

                "action_topic": "/devices/{device.id}/controls/state",
                "action_template": "{{ 'heating' if value == '1' else 'idle' }}"
            }
        },
        "rollshutter": {
            "type": "cover",
            "mod": {
                "device_class": "shutter",
                "state_topic": "/devices/{device.id}/controls/state",
                "state_stopped": "stopped",
                "position_topic": "/devices/{device.id}/controls/targetPosition",
                "set_position_topic": "/devices/{device.id}/controls/targetPosition/on",
                "payload_close": "{control.meta.min}",
                "payload_open": "{control.meta.max}",
                "position_closed": "{control.meta.min}",
                "position_open": "{control.meta.max}",
                "payload_stop": null,
                "command_topic": "/devices/{device.id}/controls/targetPosition/on"
            }
        },
        "zigbeeSwitchLight": {
            "type": "light",
            "mod": {
                "availability": {
                    "topic": "zigbee2mqtt/bridge/state",
                    "value_template": "{{ value_json.state }}"
                },
                "state_topic": "zigbee2mqtt/{device.id}",
                "state_value_template": "{{ value_json.{control.id} }}",
                "payload_off": "OFF",
                "payload_on": "ON",
                "command_topic": "zigbee2mqtt/{device.id}/{path}/set"
            }
        },
        "zigbeeSwitchLightLeft": {
            "namedModifiers": ["zigbeeSwitchLight"],
            "mod": {
                "command_topic": "zigbee2mqtt/{device.id}/left/set"
            }
        },
        "zigbeeSwitchLightRight": {
            "namedModifiers": ["zigbeeSwitchLight"],
            "mod": {
                "command_topic": "zigbee2mqtt/{device.id}/right/set"
            }
        },
        "zigbeeSwitchFan": {
            "type": "fan",
            "mod": {
                "availability": {
                    "topic": "zigbee2mqtt/bridge/state",
                    "value_template": "{{ value_json.state }}"
                },
                "state_topic": "zigbee2mqtt/{device.id}",
                "state_value_template": "{{ value_json.{control.id} }}",
                "payload_off": "OFF",
                "payload_on": "ON",
                "command_topic": "zigbee2mqtt/{device.id}/set",
                "command_template": "{\"{control.id}\": \"{{ value }}\"}"
            }
        }
    }
}

