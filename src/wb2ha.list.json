{
    "only": [
        "house_power",
        "out_sensor",
        "system/Current uptime",
        "fl2_north_bedroom_sensor",
        "fl1_hall_sensor",
        "wb-led_32"
    ],

    "exclude": [
        "system/DTS Version",
        "hwmon"
    ],

    "mods": {
        "wbLedLight": {
            "mod": {
                "brightness_state_topic": "/devices/{device.id}/controls/{control.id} Brightness",
                "brightness_command_topic": "/devices/{device.id}/controls/{control.id} Brightness/on",
                "brightness_scale": 100
            },
            "type": "light"
        },
        "thermostat": {
            "type": "climate",
            "mod": {
                "preset_modes": [
                    "off",
                    "low",
                    "on",
                    "hi"
                ],
                "preset_mode_state_topic": "/devices/{device.id}/controls/mode",
                "preset_mode_command_topic": "/devices/{device.id}/controls/mode/on",
                "current_temperature_topic": "/devices/{device.id}/controls/temperature",
                "max_temp": "{control.meta.max}",
                "min_temp": "{control.meta.min}",
                "temperature_command_topic": "/devices/{device.id}/controls/{control.id}/on",
                "temperature_state_topic": "/devices/{device.id}/controls/{control.id}",
                "temperature_unit": "C",
                "action_topic": "/devices/{device.id}/controls/state",
                "action_template": "{{ 'heating' if value == 1 else 'idle' }}"
            }
        }
    },

    "modify": {

        "dev": {

        },

        "wb-led_32": {
            "Channel 4": {
                "mods": [
                    "wbLedLight"
                ]
            }
        },
        "fl2_south_toilet_thermostat": {
            "setPoint": {
                "mods": [
                    "thermostat"
                ]
            }
        },
        "fl1_hall_sensor": {
            "Max Motion": {
                "mods": [
                    "motionPercent"
                ]
            },
            "Current Motion": {
                "mods": [
                    "motionPercent"
                ]
            }
        },
        "fl2_south_bedroom_sensor": {
            "Temperature": {}, 
            "Humidity": {}, 
            "CO2": {}, 
            "Air Quality (VOC)": {},
            "Sound Level": {}, 
            "Illuminance": {}, 
            "Max Motion": {
                "mods": [
                    "motionPercent"
                ]
            },
            "Current Motion": {
                "mods": [
                    "motionPercent"
                ]
            },
            "Buzzer": {}
        }
    }
}

