{
    "only": [
        "house_power",
        "out_sensor",
        "system/Current uptime",
        "fl2_north_bedroom_sensor",
        "fl1_hall_sensor",
        "wb-led_32",
        "fl1_living_sensor"
    ],

    "exclude": [
        "system/DTS Version",
        "hwmon"
    ],

    "mods": {
        "wbLedLight": {
            "mod": {
                "brightness_state_topic": "/devices/{device.id}/controls/{control.id} Brightness",
                "brightness_command_topic": "/devices/{device.id}/controls/{control.id} Brightness/on",
                "brightness_scale": 100
            },
            "type": "light"
        },
        "thermostat": {
            "type": "climate",
            "mod": {
                "current_temperature_topic": "/devices/{device.id}/controls/temperature",
                "max_temp": "{control.meta.max}",
                "min_temp": "{control.meta.min}",
                "temperature_command_topic": "/devices/{device.id}/controls/{control.id}/on",
                "temperature_state_topic": "/devices/{device.id}/controls/{control.id}",
                "temperature_unit": "C",

                "preset_modes": [
                    "off",
                    "low",
                    "on",
                    "hi"
                ],
                "preset_mode_state_topic": "/devices/{device.id}/controls/mode",
                "preset_mode_command_topic": "/devices/{device.id}/controls/mode/on",

                "modes": [
                    "heat",
                    "off"
                ],
                "mode_state_topic": "/devices/{device.id}/controls/mode",
                "mode_state_template": "{{ 'off' if value == 'off' else 'heat' }}",
                "mode_command_topic": "/devices/{device.id}/controls/mode/on",
                "mode_command_template": "{{ 'off' if value == 'off' else 'on' }}",

                "action_topic": "/devices/{device.id}/controls/state",
                "action_template": "{{ 'heating' if value == '1' else 'idle' }}"
            }
        },
        "zigbeeSwitchLight": {
            "type": "light",
            "mod": {
                "availability": {
                    "topic": "zigbee2mqtt/bridge/state",
                    "value_template": "{{ value_json.state }}"
                },
                "state_topic": "zigbee2mqtt/{device.id}",
                "state_value_template": "{{ value_json.{control.id} }}",
                "payload_off": "OFF",
                "payload_on": "ON",
                "command_topic": "zigbee2mqtt/{device.id}/{path}/set"
            }
        },
        "zigbeeSwitchFan": {
            "type": "fan",
            "mod": {
                "availability": {
                    "topic": "zigbee2mqtt/bridge/state",
                    "value_template": "{{ value_json.state }}"
                },
                "state_topic": "zigbee2mqtt/{device.id}",
                "state_value_template": "{{ value_json.{control.id} }}",
                "payload_off": "OFF",
                "payload_on": "ON",
                "command_topic": "zigbee2mqtt/{device.id}/set",
                "command_template": "{\"{control.id}\": \"{{ value }}\"}"
            }
        }
    },

    "modify": {

        "fl2_north_toilet_light_fan": {
            "state_left": {
                "mods": [
                    "zigbeeSwitchFan"
                ]
            },
            "state_right": {
                "mods": [
                    "zigbeeSwitchLight"
                ],
                "var": {
                    "path": "right"
                }
            }
        },
        "fl1_boiler_toilet_light": {
            "state_left": {
                "mods": [
                    "zigbeeSwitchLight"
                ],
                "var": {
                    "path": "left"
                }
            },
            "state_right": {
                "mods": [
                    "zigbeeSwitchLight"
                ],
                "var": {
                    "path": "right"
                }
            }
        },
        "wb-led_32": {
            "Channel 4": {
                "mods": [
                    "wbLedLight"
                ]
            }
        },
        "house_stairs_led": {
            "Channels 1_2_3_4": {
                "mods": [
                    "wbLedLight"
                ]
            }
        },
        "fl2_south_toilet_thermostat": {
            "setPoint": {
                "mods": [
                    "thermostat"
                ]
            }
        },
        "fl1_living_thermostat": {
            "setPoint": {
                "mods": [
                    "thermostat"
                ]
            }
        },
        "fl1_hall_sensor": {
            "Max Motion": {},
            "Current Motion": {}
        },
        "fl2_south_bedroom_sensor": {
            "Temperature": {},
            "Humidity": {},
            "CO2": {},
            "Air Quality (VOC)": {},
            "Sound Level": {},
            "Illuminance": {},
            "Max Motion": {},
            "Current Motion": {},
            "Buzzer": {}
        }
    }
}

